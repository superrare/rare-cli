{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "node_modules/@rareprotocol/rare-sdk/dist/sdk/index.d.ts",
    "node_modules/@rareprotocol/rare-sdk/dist/sdk/contracts.d.ts",
    "node_modules/@rareprotocol/rare-sdk/dist/sdk/public-utils.d.ts"
  ],
  "entryPointStrategy": "resolve",
  "plugin": [
    "typedoc-plugin-markdown"
  ],
  "out": "docs/sdk/reference",
  "readme": "none",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "validation": {
    "notExported": false
  },
  "hideGenerator": true,
  "tsconfig": "tsconfig.typedoc.json"
}
